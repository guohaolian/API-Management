# Frontend dev env
# Vite will load this file when `pnpm dev` (mode=development)

# Backend base URL
# Use 127.0.0.1 to avoid browsers preferring IPv6 localhost (::1)
VITE_API_BASE_URL=http://127.0.0.1:1024

# Frontend dev server port (must match backend CORS origin in BACKEND-NEXUS/app.py)
VITE_FE_PORT=9000
