# 复制到同目录 deploy.env（已在 .gitignore，仅保留在服务器）
# cp deploy/aliyun/deploy.env.example deploy/aliyun/deploy.env
#
# 与 docs/DEPLOY-ALIYUN.md 中的生产环境一致

DEPLOY_BRANCH=main

# 浏览器访问的统一入口（Nginx :8066）
VITE_API_BASE_URL=http://8.146.239.234:8066

# 前端静态文件目录（Nginx root）
NGINX_WEB_ROOT=/var/www/nexus

SYSTEMD_UNIT=nexus-backend

# uv 可执行文件（GitHub Actions / 非交互 SSH 常不在 PATH，建议显式配置）
UV_BIN=/root/.local/bin/uv

# 模型变更且已配置 Alembic 时改为 true
RUN_DB_MIGRATE=false

# 仅当 git pull 因手动上传/本地改动失败时使用一次，成功后改回 false 或删除该行
# DEPLOY_FORCE_RESET=true
