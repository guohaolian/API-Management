# Backend env example (copy to .env and fill values)

# App
PYTHONPATH=E:\\API-Management\\BE-CAM
PORT=1024

# Auth
ALGORITHM=HS256
LOGIN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Database (PostgreSQL)
# Example: postgresql+psycopg2://cam:YOUR_PASSWORD@localhost:5432/cam
DATABASE_ENGINE=postgresql+psycopg2
DATABASE_USERNAME=cam
DATABASE_PASSWORD=YOUR_PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cam
DATABASE_URI=postgresql+psycopg2://cam:YOUR_PASSWORD@localhost:5432/cam

# Mail (optional; used when committing iteration)
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_DEFAULT_SENDER=your_email@example.com
